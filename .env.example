# Backend API Port
PORT=4000

# Option 1: Supabase REST/JS Client (Recommended for Supabase projects)
# Copy from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Option 2: Direct PostgreSQL Connection String (Works with Supabase Postgres, Neon, Railway, or local Postgres)
# Example: postgresql://postgres:YOUR_PASSWORD@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=

# Optional Frontend Direct Supabase Config (for client-side inspection / Realtime)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_API_URL=http://localhost:4000/api

# Companion App Link (session-scheduler)
VITE_SESSION_SCHEDULER_URL=http://localhost:5174
